# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/forge?schema=public"
# Optional unpooled connection string (required for Neon / connection pooling providers)
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/forge?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/resume"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/resume"

# Vercel Blob Storage (for resume photo uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# Google Gemini AI (for resume summary, experience & project bullet generation)
GEMINI_API_KEY="your_gemini_api_key_here"
